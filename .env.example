# Copy this file to .env and fill in real values. Never commit .env.
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash-lite
# Optional: use an OpenAI-compatible endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Used for the Crossref "polite pool" User-Agent.
CROSSREF_MAILTO=sarlayatejas@gmail.com

# Optional overrides
# Set to 0 to skip the local Hugging Face model (use on small hosts like Render free).
# LOCAL_EMBEDDINGS=1
# CITEVERIFY_CACHE_DIR=.cache/citeverify
# CITEVERIFY_DEMO_REPORT=data/demo/demo_report.json
# CITEVERIFY_GOLD_SET=data/gold_set.json
